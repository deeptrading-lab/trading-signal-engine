# 로컬 환경변수 템플릿.
#
# 두 봇이 같은 저장소에서 공존합니다. 친구와 공유하는 저장소이므로 개인 토큰은
# 절대 commit 되지 않도록 파일을 분리합니다.
#
#   .env       — 공유 기본값 (현재는 코디네이터 봇 토큰. 본인이 안 쓰면 비워둠)
#   .env.local — 개인/머신 override (override=True 로 .env 위에 덮임)
#
# 사용법:
#   cp .env.example .env.local
#   # .env.local 을 실제 값으로 채우고, 공유 가능한 항목만 .env 로 옮김
#
# dev_relay 진입점은 `.env` → `.env.local` 순으로 자동 로딩합니다 (PRD §3.7).
# 두 파일 모두 `.gitignore` 의 `.env.*` 패턴으로 차단되며 `.env.example` 만
# 예외로 commit 됩니다.
#
# === 코디네이터 봇 (`Hayoung AI Coordinator`) ===

# Slack Bot User OAuth Token
# 위치: api.slack.com/apps → 앱 선택 → OAuth & Permissions → "Bot User OAuth Token"
SLACK_BOT_TOKEN=xoxb-여기에붙여넣기

# Slack App-Level Token (Socket Mode 전용, scope=connections:write)
# 위치: api.slack.com/apps → 앱 선택 → Basic Information → App-Level Tokens
SLACK_APP_TOKEN=xapp-여기에붙여넣기

# 응답 허용 사용자 ID (콤마로 구분, 화이트리스트)
# 본인 user id 확인 방법은 docs/references/slack-coordinator-bot-setup.md §3-2 참조
SLACK_ALLOWED_USER_IDS=U0AE7A54NHL

# === Dev Manager 봇 (`Hayoung Dev Manager`) — 개인 봇, .env.local 권장 ===

# Slack Bot User OAuth Token (별도 App)
SLACK_DEV_RELAY_BOT_TOKEN=xoxb-여기에붙여넣기

# Slack App-Level Token (별도 App, Socket Mode)
SLACK_DEV_RELAY_APP_TOKEN=xapp-여기에붙여넣기

# 응답 허용 사용자 ID (미설정 시 코드 기본값 사용)
DEV_RELAY_ALLOWED_USER_IDS=U0AE7A54NHL

# (선택) Anthropic API 키 — 설정 시 API 키 모드, 미설정·삭제 시 구독 모드
# 구독 모드는 로컬 `claude` CLI 가 Claude.ai 구독 계정으로 로그인되어 있어야 함
# (`claude /login`). 구독을 쓰려면 아래 줄 자체를 .env.local 에 두지 않습니다.
# ANTHROPIC_API_KEY=sk-ant-여기에붙여넣기

# OpenAI API 키 — ai-signal-workbench 분석/기획 및 Responses API 호출용.
# 실제 값은 .env.local 또는 배포 secret manager에만 둡니다.
# OPENAI_API_KEY=sk-proj-여기에붙여넣기

# Workbench API 보호용 키 — App Runner/Vercel 등 배포 환경에서는 반드시 설정합니다.
# 클라이언트는 Authorization: Bearer <key> 또는 X-API-Key 헤더로 전달합니다.
# WORKBENCH_API_KEYS=쉼표로_구분한_API_KEY_목록

# 로컬 개발/테스트에서만 인증을 끄고 싶을 때 1로 설정합니다. 배포 환경에서는 사용하지 않습니다.
# ALLOW_UNAUTHENTICATED_WORKBENCH=1

# 프로세스 메모리 기반 기본 rate-limit. 외부 공개 환경에서는 WAF/API Gateway와 병행 권장.
# WORKBENCH_RATE_LIMIT_REQUESTS=30
# WORKBENCH_RATE_LIMIT_WINDOW_SECONDS=60

# FastAPI 바인딩. App Runner/Docker 기본값은 0.0.0.0 입니다.
# HOST=0.0.0.0
# PORT=8000

# === 공통 ===

# (선택) 로그 레벨 — DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# === Bitcoin Signal OpenAI 설정 — .env.local 전용 권장 ===

# OpenAI API key. 실제 키는 절대 commit 하지 않습니다.
# 대화, 로그, 스크린샷에 노출된 키는 폐기하고 새 키를 발급하세요.
# OPENAI_API_KEY=sk-proj-새키를여기에붙여넣기

OPENAI_NEWS_MODEL=gpt-5.4-nano
OPENAI_BRIEF_MODEL=gpt-5.4-mini
ANTHROPIC_BRIEF_MODEL=claude-3-5-haiku-20241022
OPENAI_MONTHLY_BILLING_LIMIT_USD=20
OPENAI_DAILY_COST_LIMIT_USD=0.50
NEWS_REFRESH_MAX_ARTICLES=8
NEWS_REFRESH_MAX_INPUT_TOKENS=6000
MORNING_BRIEF_MAX_OUTPUT_TOKENS=900
MANUAL_BRIEF_MAX_OUTPUT_TOKENS=1200
BITCOIN_SIGNAL_TIMEZONE=Asia/Tokyo
