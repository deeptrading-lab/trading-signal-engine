# Supabase backend-only access
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Protects every mutating endpoint and the Engine WebSocket.
ENGINE_WRITE_TOKEN=<long-random-secret>

# KIS Open API
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ENVIRONMENT=prod
KIS_STREAM_ENABLED=false
KIS_SYMBOLS=005930,000660,005380

# Optional endpoint overrides
# KIS_REST_URL=https://openapi.koreainvestment.com:9443
# KIS_WS_URL=ws://ops.koreainvestment.com:21000/tryitout

HOST=0.0.0.0
PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
LOG_LEVEL=INFO
